# JWT
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=24h

# Demo
DEMO_OTP=123456

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
